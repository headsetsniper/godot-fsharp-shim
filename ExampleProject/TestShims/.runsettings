<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <RunConfiguration>
        <MaxCpuCount>1</MaxCpuCount>
        <TestAdaptersPaths>.</TestAdaptersPaths>
        <TestSessionTimeout>120000</TestSessionTimeout>
        <TreatNoTestsAsError>false</TreatNoTestsAsError>
        <EnvironmentVariables>
            <GODOT_BIN>H:\Tools\GodotMono\Godot_v4.5-stable_mono_win64.exe</GODOT_BIN>
        </EnvironmentVariables>
    </RunConfiguration>
    <LoggerRunSettings>
        <Loggers>
            <Logger friendlyName="console" enabled="False">
                <Configuration>
                    <Verbosity>detailed</Verbosity>
                </Configuration>
            </Logger>
        </Loggers>
    </LoggerRunSettings>
    <GdUnit4>
        <Parameters>-d -v --headless --audio-driver Dummy --rendering-driver opengl3 --screen 0</Parameters>
        <CaptureStdOut>true</CaptureStdOut>
        <CompileProcessTimeout>20000</CompileProcessTimeout>
    </GdUnit4>
</RunSettings>
