<Project Sdk="Godot.NET.Sdk/4.5.0">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\..\..\FSharp.Tests\.runsettings</RunSettingsFilePath>
    <VSTestTestAdapterPath>none</VSTestTestAdapterPath>
    <TestFramework>GdUnit4</TestFramework>
    <GdUnitKillStaleTestHosts>true</GdUnitKillStaleTestHosts>
    <NoWarn>$(NoWarn);0436</NoWarn>
    <!-- Generate test shims into this project under Scripts/GeneratedTests -->
    <FSharpShimsMode>Tests</FSharpShimsMode>
    <FSharpShimsOutDir>$(MSBuildProjectDirectory)\Scripts\GeneratedTests</FSharpShimsOutDir>
  <FSharpShimsTestAssemblyName>FSharp.Tests</FSharpShimsTestAssemblyName>
    <!-- Prefer local ShimGen targets during repo development -->
    <UseLocalShimGen Condition="Exists('..\..\ShimGen\buildTransitive\Headsetsniper.Godot.FSharp.ShimGen.targets')">true</UseLocalShimGen>
      <FSharpShimsVerbose>true</FSharpShimsVerbose>
      <FSharpShimsRegenerate>all</FSharpShimsRegenerate>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the F# test assembly to scan for test suites -->
    <ProjectReference Include="..\..\FSharp.Tests\FSharp.Tests.fsproj" />
    <!-- Ensure the local ShimGen tool is built so ForceGenerateTestShims can execute it. Do not reference its output assembly. -->
    <ProjectReference Include="..\..\ShimGen\Headsetsniper.Godot.FSharp.ShimGen.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalShimGen)'!='true'">
    <PackageReference Include="Headsetsniper.Godot.FSharp.ShimGen" Version="0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build;buildTransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="..\..\ShimGen\buildTransitive\Headsetsniper.Godot.FSharp.ShimGen.targets"
          Condition="'$(UseLocalShimGen)'=='true'" />

  <ItemGroup>
    <!-- Include gdUnit4 adapters/analyzers to run tests -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="gdUnit4.api" Version="5.0.0" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
    <PackageReference Include="gdUnit4.analyzers" Version="1.0.0">
      <PrivateAssets>none</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Include the adapter bridge sources and addon dotnet wrappers similar to ExampleProject -->
    <Compile Include="..\gdunit4_testadapter_v5\**\*.cs" />
    <!-- Avoid duplicate gdUnit4 C# API type conflicts: only include addon dotnet sources when building for export (not editor) AND not already referenced via main project. -->
    <Compile Include="..\addons\gdUnit4\src\dotnet\**\*.cs" Visible="false" Condition="'$(GodotTargetPlatform)'!='windows-editor' and '$(IncludeGdUnitAddonSources)'=='true'" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Default: do not include addon sources to prevent duplicate type warnings -->
    <IncludeGdUnitAddonSources>false</IncludeGdUnitAddonSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GodotTargetPlatform)'!='windows-editor'">
    <DefineConstants>$(DefineConstants);GDUNIT4NET_API_V5</DefineConstants>
  </PropertyGroup>

  <!-- Local fallback: explicitly run ShimGen in Tests mode against the FSharp.Tests assembly to ensure wrappers are generated -->
  <PropertyGroup>
    <_LocalShimGenDll>$(MSBuildProjectDirectory)\..\..\ShimGen\bin\$(Configuration)\$(TargetFramework)\Headsetsniper.Godot.FSharp.ShimGen.dll</_LocalShimGenDll>
    <_FSharpTestsDll>$(MSBuildProjectDirectory)\..\..\FSharp.Tests\.godot\mono\temp\bin\$(Configuration)\FSharp.Tests.dll</_FSharpTestsDll>
  </PropertyGroup>
  <Target Name="ForceGenerateTestShims"
          AfterTargets="BuildProjectReferences;ResolveReferences"
          BeforeTargets="CoreCompile"
          Condition="Exists('$(_LocalShimGenDll)')">
    <Message Importance="High" Text="[shimgen][tests][force] tool=$(_LocalShimGenDll) testAsm=$(_FSharpTestsDll) toolExists=$(Exists('$(_LocalShimGenDll)')) testAsmExists=$(Exists('$(_FSharpTestsDll)')) out=$(FSharpShimsOutDir)" />
    <MakeDir Directories="$(FSharpShimsOutDir)" Condition="!Exists('$(FSharpShimsOutDir)')" />
    <Exec Condition="Exists('$(_FSharpTestsDll)')"
          Command='dotnet &quot;$(_LocalShimGenDll)&quot; &quot;$(_FSharpTestsDll)&quot; &quot;$(FSharpShimsOutDir)&quot; &quot;$(MSBuildProjectDirectory)\..\..\FSharp.Tests&quot; --mode=Tests'
          EnvironmentVariables="SHIMGEN_MODE=Tests;SHIMGEN_QUIET=0"
          StandardOutputImportance="Normal" StandardErrorImportance="High" />
    <Message Condition="!Exists('$(_FSharpTestsDll)')" Importance="High" Text="[shimgen][tests][force][skip] test assembly missing at $(_FSharpTestsDll)" />
    <ItemGroup>
      <Compile Remove="$(FSharpShimsOutDir)\**\*.cs" />
      <Compile Include="$(FSharpShimsOutDir)\**\*.cs" Visible="false" />
    </ItemGroup>
  </Target>
  <Target Name="DiagReferencePaths" AfterTargets="ResolveReferences" BeforeTargets="ForceGenerateTestShims">
    <Message Importance="High" Text="[shimgen][tests][diag] ReferencePath count=@(ReferencePath->Count())" />
    <Message Importance="High" Text="[shimgen][tests][diag] ReferencePath=@(ReferencePath)" />
  </Target>
  <Target Name="CleanInvalidGeneratedTestShims" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_InvalidShim Include="$(FSharpShimsOutDir)\$*.cs" />
    </ItemGroup>
    <Message Importance="High" Text="[shimgen][tests][clean] Removing invalid shims: @_InvalidShim" Condition="'@(_InvalidShim)'!=''" />
    <Delete Files="@(_InvalidShim)" Condition="'@(_InvalidShim)'!=''" />
  </Target>
</Project>
