<Project Sdk="Godot.NET.Sdk/4.5.0">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Local dev fallback: if CI doesn't pass ShimGenPackageVersion, use a floating version to get the latest 0.x.y -->
    <ShimGenPackageVersion Condition="'$(ShimGenPackageVersion)'==''">0.*</ShimGenPackageVersion>
    <!-- Prefer local ShimGen targets during repo development when present -->
    <UseLocalShimGen Condition="Exists('..\ShimGen\buildTransitive\Headsetsniper.Godot.FSharp.ShimGen.targets')">true</UseLocalShimGen>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\.runsettings</RunSettingsFilePath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <VSTestTestAdapterPath>none</VSTestTestAdapterPath>
    <TestFramework>GdUnit4</TestFramework>
  <GdUnitKillStaleTestHosts>true</GdUnitKillStaleTestHosts>
    </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\FSharp\\FsharpWithShim.FSharp.fsproj">
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  
    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <ProjectReference Include="..\FSharp.Tests\FSharp.Tests.fsproj" />
      <PackageReference Include="gdUnit4.api" Version="5.0.0" />
      <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
      <PackageReference Include="gdUnit4.analyzers" Version="1.0.0">
        <PrivateAssets>none</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

  <ItemGroup Condition="'$(UseLocalShimGen)'!='true'">
    <PackageReference Include="Headsetsniper.Godot.FSharp.ShimGen" Version="$(ShimGenPackageVersion)">
      <!-- Prevent any assemblies/resources from flowing into compile/runtime/output -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build;buildTransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- When developing inside this repo, import the local targets to use the latest generator behavior -->
  <Import Project="..\ShimGen\buildTransitive\Headsetsniper.Godot.FSharp.ShimGen.targets"
          Condition="'$(UseLocalShimGen)'=='true'" />

  <ItemGroup>
    <Compile Include="Scenes\**\*.cs" />
    <!-- Include hand-written scripts but exclude generated to control them explicitly below -->
    <Compile Include="Scripts\**\*.cs" Exclude="Scripts\Generated\**\*.cs" />
    <Compile Include="gdunit4_testadapter_v5\**\*.cs" />
    <!-- Include the addon C# wrapper in normal builds and Godot runtime builds; exclude only for Godot editor-driven builds (windows-editor) to avoid duplicate type registration. -->
    <Compile Include="addons\gdUnit4\src\dotnet\**\*.cs" Visible="false" Condition="'$(GodotTargetPlatform)'!='windows-editor'" />
  </ItemGroup>

  <!-- Enable the gdUnit4 .NET API bridge for non-editor builds; exclude only for windows-editor to avoid duplicate registration in the editor. -->
  <PropertyGroup Condition="'$(GodotTargetPlatform)'!='windows-editor'">
    <DefineConstants>$(DefineConstants);GDUNIT4NET_API_V5</DefineConstants>
  </PropertyGroup>

</Project>

