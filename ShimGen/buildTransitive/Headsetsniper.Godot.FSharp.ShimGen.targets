<Project>
  <PropertyGroup>
    <FSharpShimsEnabled Condition="'$(FSharpShimsEnabled)'==''">true</FSharpShimsEnabled>
    <FSharpShimsDefaultScriptsOutDir>$(MSBuildProjectDirectory)\Scripts\Generated</FSharpShimsDefaultScriptsOutDir>
    <FSharpShimsOutDir Condition="'$(FSharpShimsOutDir)'==''">$(FSharpShimsDefaultScriptsOutDir)</FSharpShimsOutDir>
    <!-- Mode: Scripts or Tests -->
    <FSharpShimsMode Condition="'$(FSharpShimsMode)'==''">Scripts</FSharpShimsMode>
    <!-- Controls diagnostic verbosity of [shimgen] messages and stdout during build (default: false) -->
    <FSharpShimsVerbose Condition="'$(FSharpShimsVerbose)'==''">false</FSharpShimsVerbose>
    <!-- Include generated shims as a fallback when the generator didn't add Compile items (e.g., Godot editor build) -->
    <FSharpShimsFallbackInclude Condition="'$(FSharpShimsFallbackInclude)'==''">true</FSharpShimsFallbackInclude>
    <!-- Optional regenerate control forwarded to the tool as SHIMGEN_REGENERATE_SCRIPTS -->
    <FSharpShimsRegenerate Condition="'$(FSharpShimsRegenerate)'==''"></FSharpShimsRegenerate>
    <!-- Opt-in: kill only testhost processes hosting THIS project before VSTest (Windows only). -->
    <!-- Back-compat: honor KillStaleTestHosts if provided by the project/CLI. -->
    <GdUnitKillStaleTestHosts Condition="'$(GdUnitKillStaleTestHosts)'==''">$(KillStaleTestHosts)</GdUnitKillStaleTestHosts>
    <GdUnitKillStaleTestHosts Condition="'$(GdUnitKillStaleTestHosts)'==''">false</GdUnitKillStaleTestHosts>
  </PropertyGroup>

  <PropertyGroup>
    <FSharpShimsDefaultTestsOutDir>$(MSBuildProjectDirectory)\Scripts\GeneratedTests</FSharpShimsDefaultTestsOutDir>
    <FSharpShimsOutDir Condition="'$(FSharpShimsMode)'=='Tests' and $([System.String]::Equals('$(FSharpShimsOutDir)','$(FSharpShimsDefaultScriptsOutDir)', System.StringComparison.OrdinalIgnoreCase))">$(FSharpShimsDefaultTestsOutDir)</FSharpShimsOutDir>
  </PropertyGroup>

  <PropertyGroup>
    <FSharpShimsLogImportance Condition="'$(FSharpShimsLogImportance)'=='' and '$(FSharpShimsVerbose)'=='true'">High</FSharpShimsLogImportance>
    <FSharpShimsLogImportance Condition="'$(FSharpShimsLogImportance)'==''">Low</FSharpShimsLogImportance>
    <FSharpShimsStdOutImportance Condition="'$(FSharpShimsStdOutImportance)'=='' and '$(FSharpShimsVerbose)'=='true'">Normal</FSharpShimsStdOutImportance>
    <FSharpShimsStdOutImportance Condition="'$(FSharpShimsStdOutImportance)'==''">Low</FSharpShimsStdOutImportance>
  </PropertyGroup>

  <!-- Resolve ShimGen tool from the restored package (robust across CI/local) -->
  <Target Name="ResolveShimGenToolPath" BeforeTargets="RunShimGen" Condition=" '$(FSharpShimsEnabled)' != 'false' ">
    <ItemGroup>
      <_ShimGenPkg Include="@(PackageReference)" Condition="'%(PackageReference.Identity)' == 'Headsetsniper.Godot.FSharp.ShimGen'" />
    </ItemGroup>
    <PropertyGroup>
      <_ShimGenVersion>%(_ShimGenPkg.Version)</_ShimGenVersion>
      <!-- NuGet root discovery: prefer property, then env var, then HOME/USERPROFILE default -->
      <_NuGetRoot>$(NuGetPackageRoot)</_NuGetRoot>
      <_NuGetRoot Condition="'$(_NuGetRoot)' == ''">$([System.Environment]::GetEnvironmentVariable('NUGET_PACKAGES'))</_NuGetRoot>
      <_HomeDir>$([System.Environment]::GetEnvironmentVariable('HOME'))</_HomeDir>
      <_UserProfileDir>$([System.Environment]::GetEnvironmentVariable('USERPROFILE'))</_UserProfileDir>
      <_HomeDir Condition="'$(_HomeDir)' == ''">$(_UserProfileDir)</_HomeDir>
      <_NuGetRoot Condition="'$(_NuGetRoot)' == '' and '$(_HomeDir)' != ''">$([System.IO.Path]::Combine('$(_HomeDir)', '.nuget', 'packages'))</_NuGetRoot>
      <_ShimGenToolFromPkg>$([System.IO.Path]::Combine('$(_NuGetRoot)', 'headsetsniper.godot.fsharp.shimgen', '$(_ShimGenVersion)', 'lib', '$(TargetFramework)', 'Headsetsniper.Godot.FSharp.ShimGen.dll'))</_ShimGenToolFromPkg>
      <!-- Local repo fallback (dev) -->
      <_ShimGenLocalBin>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', 'bin', '$(Configuration)', '$(TargetFramework)', 'Headsetsniper.Godot.FSharp.ShimGen.dll'))</_ShimGenLocalBin>
      <!-- Packed nupkg fallback (lib tfm next to targets) -->
      <_ShimGenLibNextToTargets>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', 'lib', '$(TargetFramework)', 'Headsetsniper.Godot.FSharp.ShimGen.dll'))</_ShimGenLibNextToTargets>
      <_ShimGenTool Condition="Exists('$(_ShimGenToolFromPkg)')">$(_ShimGenToolFromPkg)</_ShimGenTool>
      <_ShimGenTool Condition="'$(_ShimGenTool)' == '' and Exists('$(_ShimGenLocalBin)')">$(_ShimGenLocalBin)</_ShimGenTool>
      <_ShimGenTool Condition="'$(_ShimGenTool)' == '' and Exists('$(_ShimGenLibNextToTargets)')">$(_ShimGenLibNextToTargets)</_ShimGenTool>
  <!-- Prefer local bin if available during repo/dev builds; this helps stage deps.json for Roslyn tooling. -->
  <_ShimGenTool Condition="'$(MSBuildThisFileDirectory)' != '' and Exists('$(_ShimGenLocalBin)')">$(_ShimGenLocalBin)</_ShimGenTool>
    </PropertyGroup>
    <Message Text="[shimgen] Tool candidates: pkg=$(_ShimGenToolFromPkg)[exists=$([System.IO.File]::Exists('$(_ShimGenToolFromPkg)'))] localBin=$(_ShimGenLocalBin)[exists=$([System.IO.File]::Exists('$(_ShimGenLocalBin)'))] libNext=$(_ShimGenLibNextToTargets)[exists=$([System.IO.File]::Exists('$(_ShimGenLibNextToTargets)'))]" Importance="$(FSharpShimsLogImportance)" />
  </Target>

  <!-- Collect F# outputs via ReferencePath (populated by ResolveReferences) -->
  <Target Name="CollectFSharpOutputs" AfterTargets="ResolveReferences" BeforeTargets="RunShimGen" Condition=" '$(FSharpShimsEnabled)' != 'false' ">
    <ItemGroup>
      <_FSharpRefs Include="@(ReferencePath)" Condition="$([System.String]::Copy('%(ReferencePath.MSBuildSourceProjectFile)').EndsWith('.fsproj', System.StringComparison.OrdinalIgnoreCase))" />
      <!-- Try to find the Annotations assembly among resolved references -->
      <_AnnRef Include="@(ReferencePath)"
               Condition="$([System.String]::Copy('%(ReferencePath.Identity)').EndsWith('Headsetsniper.Godot.FSharp.Annotations.dll', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <Message Text="[shimgen] F# ReferencePath count=@(_FSharpRefs->Count())" Importance="$(FSharpShimsLogImportance)" />
    <Message Text="[shimgen] Annotations ref: @(_AnnRef)" Importance="$(FSharpShimsLogImportance)" Condition="'@(_AnnRef)' != ''" />
  </Target>

  <!-- Run generator and include outputs in same compile -->
  <Target Name="RunShimGen" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile;Compile" Condition=" '$(FSharpShimsEnabled)' != 'false' and '@(_FSharpRefs)' != '' and Exists('$(_ShimGenTool)') ">
    <MakeDir Directories="$(FSharpShimsOutDir)" Condition="!Exists('$(FSharpShimsOutDir)')" />
    <Message Text="[shimgen] Using tool: $(_ShimGenTool)" Importance="$(FSharpShimsLogImportance)" />
    <Message Text="[shimgen] F# assemblies: @(_FSharpRefs)" Importance="$(FSharpShimsLogImportance)" />
    <!-- Stage the tool in obj with any required runtime dependencies so 'dotnet' can resolve compile-time references -->
    <PropertyGroup>
      <_ShimGenStageDir>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'shimgen_tool_stage', '$(TargetFramework)'))</_ShimGenStageDir>
      <_ShimGenStageDll>$([System.IO.Path]::Combine('$(_ShimGenStageDir)', 'Headsetsniper.Godot.FSharp.ShimGen.dll'))</_ShimGenStageDll>
      <_ShimGenStageRuntimeConfig>$([System.IO.Path]::Combine('$(_ShimGenStageDir)', 'Headsetsniper.Godot.FSharp.ShimGen.runtimeconfig.json'))</_ShimGenStageRuntimeConfig>
      <_ShimGenToolDir>$([System.IO.Path]::GetDirectoryName('$(_ShimGenTool)'))</_ShimGenToolDir>
      <_ShimGenToolDeps>$([System.IO.Path]::Combine('$(_ShimGenToolDir)', 'Headsetsniper.Godot.FSharp.ShimGen.deps.json'))</_ShimGenToolDeps>
      <_ShimGenStageDeps>$([System.IO.Path]::Combine('$(_ShimGenStageDir)', 'Headsetsniper.Godot.FSharp.ShimGen.deps.json'))</_ShimGenStageDeps>
    </PropertyGroup>
    <MakeDir Directories="$(_ShimGenStageDir)" Condition="!Exists('$(_ShimGenStageDir)')" />
    <Copy SourceFiles="$(_ShimGenTool)" DestinationFiles="$(_ShimGenStageDll)" SkipUnchangedFiles="true" />
    <!-- If available (local build), copy deps.json so dotnet can resolve PackageReferences (Roslyn) from the global package cache -->
    <Copy SourceFiles="$(_ShimGenToolDeps)" DestinationFiles="$(_ShimGenStageDeps)" SkipUnchangedFiles="true" Condition="Exists('$(_ShimGenToolDeps)')" />
    <!-- Co-locate the Annotations DLL if we can find it in ReferencePath -->
    <Copy SourceFiles="@(_AnnRef)" DestinationFolder="$(_ShimGenStageDir)" SkipUnchangedFiles="true" Condition="'@(_AnnRef)' != ''" />
    <!-- Ensure a minimal runtimeconfig is present so 'dotnet' treats the staged DLL as framework-dependent -->
    <WriteLinesToFile
        File="$(_ShimGenStageRuntimeConfig)"
        Overwrite="false"
        Condition="!Exists('$(_ShimGenStageRuntimeConfig)')"
        Lines='{
  "runtimeOptions": {
    "tfm": "net9.0",
    "framework": {
      "name": "Microsoft.NETCore.App",
      "version": "9.0.0"
    },
    "rollForward": "LatestMajor"
  }
}' />
    <Message Text="[shimgen] Staged tool at $(_ShimGenStageDll) (ann=@(_AnnRef->'%(Filename)%(Extension)'))" Importance="$(FSharpShimsLogImportance)" />
    <PropertyGroup>
      <!-- Forward regenerate control to tool only when set -->
      <_ShimGenEnvVars Condition="'$(FSharpShimsRegenerate)'!=''">SHIMGEN_REGENERATE_SCRIPTS=$(FSharpShimsRegenerate)</_ShimGenEnvVars>
      <_ShimGenEnvVars>SHIMGEN_MODE=$(FSharpShimsMode);$(_ShimGenEnvVars)</_ShimGenEnvVars>
    </PropertyGroup>
    <!-- In Tests mode, restrict to a specific test assembly name if provided -->
    <ItemGroup Condition="'$(FSharpShimsMode)'=='Tests' and '$(FSharpShimsTestAssemblyName)'==''">
      <_FSharpRefsTestCandidate Include="@(_FSharpRefs)" Condition="$([System.String]::Copy('%(Filename)').EndsWith('Tests', System.StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(FSharpShimsMode)'=='Tests' and '$(FSharpShimsTestAssemblyName)'=='' and '@(_FSharpRefsTestCandidate)'!=''">
      <FSharpShimsTestAssemblyName>$([System.String]::Copy('@(_FSharpRefsTestCandidate->'%(Filename)')').Split(';')[0])</FSharpShimsTestAssemblyName>
    </PropertyGroup>
    <Message Text="[shimgen] Tests mode auto-selected FSharpShimsTestAssemblyName=$(FSharpShimsTestAssemblyName)" Importance="$(FSharpShimsLogImportance)" Condition="'$(FSharpShimsMode)'=='Tests' and '$(FSharpShimsTestAssemblyName)'!='' and '@(_FSharpRefsTestCandidate)'!=''" />

    <ItemGroup Condition="'$(FSharpShimsMode)'=='Tests' and '$(FSharpShimsTestAssemblyName)'!=''">
      <_FSharpRefsFiltered Include="@(_FSharpRefs)" Condition="'%(Filename)'=='$(FSharpShimsTestAssemblyName)'" />
    </ItemGroup>
    <Message Text="[shimgen] Tests mode filter: $(FSharpShimsTestAssemblyName) => @(_FSharpRefsFiltered)" Importance="$(FSharpShimsLogImportance)" Condition="'$(FSharpShimsMode)'=='Tests' and '$(FSharpShimsTestAssemblyName)'!=''" />

    <!-- Exec for Tests mode with filtered refs -->
    <Exec Condition="'$(FSharpShimsMode)'=='Tests' and '@(_FSharpRefsFiltered)'!=''"
      Command="dotnet &quot;$(_ShimGenStageDll)&quot; &quot;%(_FSharpRefsFiltered.Identity)&quot; &quot;$(FSharpShimsOutDir)&quot; &quot;$([System.IO.Path]::GetDirectoryName('%(_FSharpRefsFiltered.MSBuildSourceProjectFile)'))&quot; --mode=$(FSharpShimsMode)"
      WorkingDirectory="$([System.IO.Path]::GetDirectoryName('%(_FSharpRefsFiltered.Identity)'))"
      EnvironmentVariables="$(_ShimGenEnvVars)"
      StandardOutputImportance="$(FSharpShimsStdOutImportance)" StandardErrorImportance="High" />

    <!-- Default Exec (Scripts mode or when no filter provided/matched) -->
    <Exec Condition="! ('$(FSharpShimsMode)'=='Tests' and '@(_FSharpRefsFiltered)'!='')"
      Command="dotnet &quot;$(_ShimGenStageDll)&quot; &quot;%(_FSharpRefs.Identity)&quot; &quot;$(FSharpShimsOutDir)&quot; &quot;$([System.IO.Path]::GetDirectoryName('%(_FSharpRefs.MSBuildSourceProjectFile)'))&quot; --mode=$(FSharpShimsMode)"
      WorkingDirectory="$([System.IO.Path]::GetDirectoryName('%(_FSharpRefs.Identity)'))"
      EnvironmentVariables="$(_ShimGenEnvVars)"
      StandardOutputImportance="$(FSharpShimsStdOutImportance)" StandardErrorImportance="High" />
    <ItemGroup>
      <!-- Ensure we don't end up with duplicate Compile items if included elsewhere -->
      <Compile Remove="$(FSharpShimsOutDir)\**\*.cs" />
      <Compile Include="$(FSharpShimsOutDir)\**\*.cs" Visible="false" />
      <FileWrites Include="$(FSharpShimsOutDir)\**\*.cs" />
    </ItemGroup>
  </Target>

  <!-- Fallback include: ensure generated shims are compiled when the generator didn't add them (e.g., editor-driven builds) -->
  <Target Name="FallbackIncludeGeneratedShims"
          BeforeTargets="CoreCompile;Compile"
          AfterTargets="RunShimGen"
          Condition="'$(FSharpShimsFallbackInclude)'=='true' and Exists('$(FSharpShimsOutDir)')">
    <ItemGroup>
      <Compile Remove="$(FSharpShimsOutDir)\**\*.cs" />
      <Compile Include="$(FSharpShimsOutDir)\**\*.cs" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Clean up generated files ?
  <Target Name="CleanGeneratedShims" AfterTargets="Clean">
    <RemoveDir Directories="$(FSharpShimsOutDir)" Condition="Exists('$(FSharpShimsOutDir)')" />
  </Target>
   -->
  <!-- Pre-VSTest cleanup (transitive): kill only testhost processes that are loading THIS test assembly/output dir (Windows only). -->
  <Target Name="ShimGen_PrepareKillTestHostsScript" Condition="'$(GdUnitKillStaleTestHosts)'=='true' and '$(OS)'=='Windows_NT'" DependsOnTargets="Build">
    <PropertyGroup>
      <_KillScript>$(IntermediateOutputPath)KillStaleTestHosts.ps1</_KillScript>
      <_TestAssemblyName>$(AssemblyName).dll</_TestAssemblyName>
      <_OutDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\</_OutDir>
    </PropertyGroup>
    <ItemGroup>
      <_KillScriptLines Include="param([string]$AsmName, [string]$OutDir)" />
      <_KillScriptLines Include="$query = &quot;Name like 'testhost%.exe' or Name = 'testhost.exe' or Name = 'dotnet.exe'&quot;" />
      <_KillScriptLines Include="Get-CimInstance Win32_Process -Filter $query | Where-Object { $_.CommandLine -and ($_.CommandLine -like ('*' + $AsmName + '*') -or $_.CommandLine -like ($OutDir + '*')) } | ForEach-Object { try { Stop-Process -Id $_.ProcessId -Force -ErrorAction Stop } catch {} }" />
    </ItemGroup>
    <WriteLinesToFile File="$(_KillScript)" Lines="@(_KillScriptLines)" Overwrite="true" />
    <Message Importance="High" Text="[shimgen][pre-vstest] Prepared kill script: $(_KillScript) (Asm=$(_TestAssemblyName), OutDir=$(_OutDir))" />
  </Target>

  <Target Name="ShimGen_KillTestHostsForThisProject" BeforeTargets="VSTest" Condition="'$(GdUnitKillStaleTestHosts)'=='true' and '$(OS)'=='Windows_NT'" DependsOnTargets="ShimGen_PrepareKillTestHostsScript">
    <PropertyGroup>
      <_KillScript>$(IntermediateOutputPath)KillStaleTestHosts.ps1</_KillScript>
      <_TestAssemblyName>$(AssemblyName).dll</_TestAssemblyName>
      <_OutDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\</_OutDir>
    </PropertyGroup>
    <Message Importance="High" Text="[shimgen][pre-vstest] Killing stale testhosts for $(AssemblyName) in $(_OutDir)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_KillScript)&quot; -AsmName &quot;$(_TestAssemblyName)&quot; -OutDir &quot;$(_OutDir)&quot;" />
  </Target>
</Project>
