<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PackageId>Headsetsniper.Godot.FSharp.Templates</PackageId>
    <Title>Godot F# Templates</Title>
    <Authors>headsetsniper</Authors>
    <Description>dotnet new templates for Godot gameplay authored in F# with optional GdUnit4 test scaffolding.</Description>
    <PackageVersion>0.1.0</PackageVersion>
    <PackageType>Template</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/headsetsniper/godot-fsharp-shim</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Pack="true" PackagePath="content/" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
